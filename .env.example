# Local development defaults. Replace all placeholder values before use.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DB_ENGINE=sqlite

# Production requires PostgreSQL, a unique Django secret, and a Fernet key.
# Keep real secrets in the deployment platform's environment settings, never here.
DATABASE_URL=
FIELD_ENCRYPTION_KEY=
DB_CONN_MAX_AGE=0

# Vercel supplies VERCEL_ENV, VERCEL_URL (the current deployment hostname),
# and VERCEL_PROJECT_PRODUCTION_URL (the project's production hostname).
# Set these only when configuring the environment locally; the app accepts exact
# hostnames and creates HTTPS CSRF origins for the two Vercel host variables.
VERCEL_ENV=
VERCEL_URL=
VERCEL_PROJECT_PRODUCTION_URL=

# Add custom production/preview hostnames as exact comma-separated hostnames.
# Add full HTTPS origins only when they differ from SITE_URL / Vercel origins.
SITE_URL=http://127.0.0.1:8000
# Example production values: DJANGO_ALLOWED_HOSTS=clinic.example.com,preview.example.com
# Example: DJANGO_CSRF_TRUSTED_ORIGINS=https://admin.example.com

# Optional deployment hardening. Defaults are enabled when DJANGO_DEBUG=false.
DJANGO_SECURE_SSL_REDIRECT=
DJANGO_SESSION_COOKIE_SECURE=
DJANGO_CSRF_COOKIE_SECURE=
DJANGO_SECURE_HSTS_SECONDS=
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_PROXY_SSL=

# Render sets RENDER_EXTERNAL_HOSTNAME automatically when hosted there.
RENDER_EXTERNAL_HOSTNAME=

# Optional email delivery configuration. Configure credentials in the platform.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=ClinicOS <no-reply@localhost>

# Local PostgreSQL Compose credentials (not intended for production).
POSTGRES_DB=clinicos
POSTGRES_USER=clinicos
POSTGRES_PASSWORD=clinicos-dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_APP_USER=clinicos_app
POSTGRES_APP_PASSWORD=replace-with-a-distinct-app-password

FREE_PATIENT_LIMIT=100
FREE_ENCOUNTERS_MONTHLY_LIMIT=250
API_ANON_RATE=120/hour
API_USER_RATE=1000/hour
API_LOGIN_RATE=10/minute
API_REGISTER_RATE=5/hour
